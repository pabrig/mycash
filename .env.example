# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Solo claves PÚBLICAS del cliente. NUNCA pongas service_role acá.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Site URL for magic links (local / prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature flags (testing local / rollouts)
# Valores: 1|true|on|yes  ·  0|false|off|no
# Sin variable = default (skipAuth off; savingsGoals on; savingsLocations on)
#
# NEXT_PUBLIC_FF_SKIP_AUTH=1
# NEXT_PUBLIC_FF_SAVINGS_GOALS=0
# NEXT_PUBLIC_FF_SAVINGS_LOCATIONS=0
#
# Opcional: íconos de marca por nombre (https://www.logo.dev — plan Community gratis).
# Sin esta clave, usamos un catálogo local (Brubank, Galicia, MP, etc.) + inicial.
# NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=pk_...
#
# Para un flag nuevo: agregalo en src/lib/feature-flags.ts y documentalo acá.
